@page "/category/{CategoryId}"
@using ForumApp.Data
@using ForumApp.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation    

<h3>@categoryName</h3>

@* Knapp för att skapa ny tråd i denna kategori *@
<a href="/create-thread/@CategoryId" class = "btn btn-primary mb-3"> create-thread</a>

@if(threads == null)
{
    <p>Laddar...</p>

}
else if (!threads.Any())
{
    <p>Inga trådar i denna kategori än. Du kan skapa</p>
}
else 
{
    <ul class ="list-group">
        @foreach (var thread in threads)
        {
            <li class ="list-group-item">
               <a href="/thread/@thread.Id">@thread.Title</a>
               <small class="text-muted d-block">@thread.CreatedAt.ToString("yyy-MM-dd")</small>
            </li>
        }
    </ul>
}

@code {
    [Parameter]
    public string CategoryId { get; set; } = "";
    private List<ForumThread>? threads;
    private string categoryName = "";

    protected override async Task OnInitializedAsync()
    {
        int id = int.Parse(CategoryId); 

        var category = await Db.Categories
        .Include(c => c.Threads)
        .FirstOrDefaultAsync(c => c.Id == id);

        if (category != null)
        {
         categoryName = category.Name;
         threads = category.Threads?.ToList() ?? new List<ForumThread>();
        }
            
        
    }
}