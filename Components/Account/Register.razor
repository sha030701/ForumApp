@page "/register"

@using Microsoft.AspNetCore.Identity
@using ForumApp.Models.ViewModels

@inject UserManager<IdentityUser> UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager Navigation


<div class="row">
    <div class="col-lg-4 offset-lg-4 pt-4 pb-4 border">
        <EditForm Model="@Model" OnValidSubmit="RegisterUser" FormName="RegisterForm">
            <DataAnnotationsValidator />
            <div class="text-center mb-3">
                <img src="avatar.png" style="width:80px;height:80px;border-radius:50%;" />
                <h3>Register</h3>
            </div>

            <div class="mb-3">
                <label>User Name</label>
                <InputText @bind-Value="Model.UserName" class="form-control" />
                <ValidationMessage For="() => Model.UserName" />
            </div>

            <div class="mb-3">
                <label>Email</label>
                <InputText @bind-Value="Model.Email"
                           class="form-control" />
                <ValidationMessage For="() => Model.Email" />
            </div>

             <div class="mb-3">
                <label>Password</label>
                <InputText @bind-Value="Model.Password"
                           class="form-control" type="Password" />
                <ValidationMessage For="() => Model.Password" />
            </div>

                <div class="mb-3">
                    <label>Confirm Password</label>
                    <InputText @bind-Value="Model.ConfirmPassword"
                            class="form-control" type="Password" />
                    <ValidationMessage For="() => Model.ConfirmPassword" />
                </div>



            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <button class="btn btn-primary w-100" type="submit">
                Register
            </button>

            <p class="mt-3 text-center">
                Already have an account?
                <a href="/LOGIN">Login here</a>
            </p>
        </EditForm>

   </div>
</div>

@code {
    [SupplyParameterFromForm]
    public RegisterViewModel Model { get; set; } = new();

    private string? errorMessage;

    private async Task RegisterUser()
    {
         //skapa en ny IdentityUser 
        var user = new IdentityUser
        {
            UserName = Model.UserName,
            Email = Model.Email,
            EmailConfirmed= true
        };

        // spara användare i databasen med hashat lösenord
        var result = await UserManager.CreateAsync(user, Model.Password!);

        if(result.Succeeded)
        {
            // loggar indirect efter registering   
         Navigation.NavigateTo("/login", forceLoad: true);

        }
        else{
            errorMessage = result.Errors.FirstOrDefault()?.Description;
        }

    }
}